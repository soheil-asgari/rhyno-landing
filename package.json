{
  "name": "rhyno-landing",
  "version": "2.0.0",
  "private": true,
  "description": "Static marketing site for Rhyno ERP (Persian, RTL, Tailwind v4)",
  "scripts": {
    "build:pages": "node ./build/pages.mjs",
    "build:css": "tailwindcss -i ./tailwind.input.css -o ./dist/css/tailwind.css --minify",
    "build:images": "node ./build/optimize-images.mjs",
    "build": "npm run build:pages && npm run build:css",
    "new-article": "node ./build/new-article.mjs",
    "serve": "node ./build/serve.mjs 3000",
    "qa:links": "node ./build/check.mjs",
    "qa:structure": "node ./build/structure.mjs",
    "qa:layout": "node ./build/audit.mjs",
    "qa:interact": "node ./build/interact.mjs",
    "qa:visual": "node ./build/visual.mjs",
    "qa": "npm run qa:links && npm run qa:structure && npm run qa:layout && npm run qa:visual && npm run qa:interact",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "marked": "^18.3.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3"
  },
  "dependencies": {
    "@vercel/speed-insights": "^2.0.0"
  }
}
